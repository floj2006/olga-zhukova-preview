# Local: node scripts/setup-admin.mjs creates these in .env.local.
# Never put real secrets in this example file or in dist/.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:4173

# Production: apply server/schema.sql, then set all five values in Vercel.
# APP_ORIGIN must be the exact HTTPS origin used to open the production site.
# Use a separate project/database for previews if testing real submissions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GALLERY_BUCKET=olga-gallery

# Public build-time origin for canonical, social previews and sitemap.
# Set in Vercel build environment when moving to a custom domain.
SITE_URL=https://olga-zhukova-preview.vercel.app

# Optional VK notifications. Keep disabled until a community token and recipient are configured.
VK_NOTIFICATIONS_ENABLED=false
VK_COMMUNITY_TOKEN=
VK_PEER_ID=

# Optional build-time analytics. Enable the corresponding Vercel products first.
# Custom conversion events require a plan supporting custom events.
NEXT_PUBLIC_WEB_ANALYTICS=false
NEXT_PUBLIC_SPEED_INSIGHTS=false
NEXT_PUBLIC_CONVERSION_ANALYTICS=false
